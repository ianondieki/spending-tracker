{
  "name": "hesabu",
  "version": "0.0.0",
  "private": true,
  "description": "Hesabu monorepo: Kenyan personal-finance companion (Android app, report backend, charts, web viewer).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @hesabu/api dev",
    "dev:worker": "pnpm --filter @hesabu/worker dev",
    "dev:web": "pnpm --filter @hesabu/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
