{
  "name": "@hesabu/renderer",
  "version": "0.0.0",
  "private": true,
  "description": "Renders a ReportDocument to HTML, hero PNG, chart PNGs and PDF.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hesabu/report-model": "workspace:*",
    "playwright": "^1.56.1"
  }
}
