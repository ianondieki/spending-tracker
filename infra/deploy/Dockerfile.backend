# One image for the API and the worker (Fly process group, Render services). Build from the repo root:
#   docker build -f infra/deploy/Dockerfile.backend -t hesabu-backend .
# Processes: `node api/dist/index.js` (API, PORT) and `node worker/dist/main.js` (worker).
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY packages/db/package.json packages/db/
COPY packages/analytics/package.json packages/analytics/
COPY packages/agents/package.json packages/agents/
COPY packages/i18n/package.json packages/i18n/
COPY packages/taxonomy/package.json packages/taxonomy/
COPY packages/pack-engine/package.json packages/pack-engine/
COPY packages/renderer/package.json packages/renderer/
COPY packages/charts/package.json packages/charts/
COPY packages/report-model/package.json packages/report-model/
RUN pnpm install --frozen-lockfile --filter "@hesabu/api..." --filter "@hesabu/worker..."
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY packages packages
COPY contracts contracts
COPY corpus corpus
RUN pnpm --filter "@hesabu/api..." --filter "@hesabu/worker..." run build \
 && pnpm --filter @hesabu/api --prod --legacy deploy /out/api \
 && pnpm --filter @hesabu/worker --prod --legacy deploy /out/worker

# Playwright needs Chromium for the hero, chart and PDF renders; the official image carries it.
FROM mcr.microsoft.com/playwright:v1.56.1-noble
ENV NODE_ENV=production TZ=Africa/Nairobi PORT=8787
WORKDIR /app
COPY --from=build /out/api /app/api
COPY --from=build /out/worker /app/worker
COPY contracts /app/contracts
COPY corpus /app/corpus
EXPOSE 8787
CMD ["node", "api/dist/index.js"]
