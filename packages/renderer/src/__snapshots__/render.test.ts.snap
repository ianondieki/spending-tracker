<div class="h-page h-page--report"><main id="report"><article class="h-report h-report--monthly h-report--web" lang="sw" data-report-id="rpt_m_2026-09_sw"><header class="h-masthead"><span class="h-masthead__brand">Hesabu</span><span class="h-masthead__kind">Ripoti ya mwezi</span><span class="h-masthead__period">Septemba 2026</span></header><h1 class="h-report__title">Septemba yako kwa pesa</h1><section class="h-hero" aria-labelledby="h-hero-total"><table class="h-tally" style="--rows:7"><caption class="h-visually-hidden">Jumla ya matumizi</caption><tbody><tr class="h-tally__row" style="--i:0"><th scope="row" class="h-tally__label">Kodi na nyumba</th><td class="h-tally__value h-num">KSh 22,000</td></tr><tr class="h-tally__row" style="--i:1"><th scope="row" class="h-tally__label">Mboga na chakula</th><td class="h-tally__value h-num">KSh 18,240</td></tr><tr class="h-tally__row" style="--i:2"><th scope="row" class="h-tally__label">Familia na marafiki</th><td class="h-tally__value h-num">KSh 12,000</td></tr><tr class="h-tally__row" style="--i:3"><th scope="row" class="h-tally__label">Usafiri</th><td class="h-tally__value h-num">KSh 11,460</td></tr><tr class="h-tally__row" style="--i:4"><th scope="row" class="h-tally__label">Umeme na maji</th><td class="h-tally__value h-num">KSh 8,199</td></tr><tr class="h-tally__row" style="--i:5"><th scope="row" class="h-tally__label">Kula nje</th><td class="h-tally__value h-num">KSh 7,310</td></tr><tr class="h-tally__row" style="--i:6"><th scope="row" class="h-tally__label">Mengine yote</th><td class="h-tally__value h-num">KSh 15,981</td></tr></tbody><tfoot><tr class="h-tally__total" style="--i:7"><th scope="row" class="h-tally__label h-tally__label--total">Jumla ya matumizi</th><td class="h-tally__value h-tally__value--total h-num" id="h-hero-total">KSh 95,190</td></tr></tfoot></table><div class="h-tally__rule" aria-hidden="true"></div><p class="h-hero__delta" data-direction="up">KSh 6,250 zaidi ya mwezi uliopita</p><p class="h-hero__