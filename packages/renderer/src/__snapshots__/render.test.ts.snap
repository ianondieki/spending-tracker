exports[`HTML outputs for weekly-sw > email HTML is table-based with cid images and a text twin 1`] = `
"<!doctype html>
<html lang="sw"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light"/><meta name="supported-color-schemes" content="light"/><title>Wiki yako kwa pesa: KSh 20,450 zilitumika, 8% zaidi</title></head><body style="margin:0;padding:0;background-color:#F3F5F7;color-scheme:light"><div style="display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1;color:#F3F5F7">Mboga 30%, Ijumaa KSh 6,350, ada KSh 312. Mambo matatu ya kuangalia.</div><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" style="background-color:#F3F5F7"><tbody><tr><td align="center" style="padding:24px 8px"><table role="presentation" width="600" cellPadding="0" cellSpacing="0" border="0" style="width:100%;max-width:600px;background-color:#FFFFFF;border-radius:8px"><tbody><tr><td style="padding:24px"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0"><tbody><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-bottom:12px;border-bottom:1px solid #C9D2DC"><span style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:700;color:#141E2E;margin:0;display:inline">Hesabu</span><span style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;display:inline;margin-left:12px">Ripoti ya wiki</span><span style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;display:inline;float:right">5 hadi 11 Oktoba 2026</span></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:24px"><h1 style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:28px;line-height:1.1;font-weight:700;color:#141E2E;margin:0">Wiki yako kwa pesa</h1></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:16px"><img src="cid:hero" width="552" alt="Jumla ya matumizi KSh 20,450, KSh +1,550 ikilinganishwa na wiki iliyopita. Ulitumia 8% zaidi ya wiki iliyopita, hasa kwa mboga na pesa ulizotuma nyumbani." style="display:block;width:100%;max-width:552px;height:auto;border:0;border-radius:8px"/></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:8px"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" style="border-collapse:collapse"><tbody><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Jumatatu</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 2,840</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Jumanne</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 1,560</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Jumatano</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 4,210</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Alhamisi</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 980</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Ijumaa</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 6,350</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Jumamosi</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 3,120</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Jumapili</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 1,390</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:3px double #141E2E;font-size:14px;text-align:left;font-weight:700;padding-left:0;border-top:1px solid #141E2E">Jumla ya matumizi</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:3px double #141E2E;font-size:14px;text-align:right;font-weight:700;padding-left:12px;border-top:1px solid #141E2E">KSh 20,450</td></tr></tbody></table><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:400;color:#141E2E;margin:0;margin-top:12px"><b style="font-weight:500">KSh 1,550 zaidi ya wiki iliyopita</b></p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.45;font-weight:400;color:#141E2E;margin:0;margin-top:12px">Ulitumia 8% zaidi ya wiki iliyopita, hasa kwa mboga na pesa ulizotuma nyumbani.</p></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:24px"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" style="border-collapse:collapse"><tbody><tr><td valign="top" style="padding:12px 8px 12px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;width:25%;border-top:1px solid #C9D2DC;border-bottom:1px solid #C9D2DC"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0">Zilizoingia</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.1;font-weight:700;color:#1E7F5C;margin:0;margin-top:4px">KSh 11,700</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">KSh -26,300</p></td><td valign="top" style="padding:12px 8px 12px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;width:25%;border-top:1px solid #C9D2DC;border-bottom:1px solid #C9D2DC"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0">Zilizotoka</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.1;font-weight:700;color:#141E2E;margin:0;margin-top:4px">KSh 20,450</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">KSh +1,550</p></td><td valign="top" style="padding:12px 8px 12px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;width:25%;border-top:1px solid #C9D2DC;border-bottom:1px solid #C9D2DC"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0">Ada</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.1;font-weight:700;color:#B7791F;margin:0;margin-top:4px">KSh 312</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">KSh +47</p></td><td valign="top" style="padding:12px 8px 12px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;width:25%;border-top:1px solid #C9D2DC;border-bottom:1px solid #C9D2DC"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0">Salio la wiki</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.1;font-weight:700;color:#141E2E;margin:0;margin-top:4px">KSh -9,062</p></td></tr></tbody></table></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:32px"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:500;color:#141E2E;margin:0">Zilizoingia zilipungua baada ya mshahara wa wiki iliyopita; matumizi yalibaki vilevile</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">Ziliingia KSh 11,700 na zikatoka KSh 20,450, kwa hivyo wiki ilifunga kwa KSh -9,062.</p><img src="cid:in_out" width="552" alt="Miraba miwili inalinganisha wiki hii na iliyopita. Wiki hii: KSh 11,700 ziliingia, KSh 20,450 zilitoka, salio KSh -9,062. Wiki iliyopita: KSh 38,000 ziliingia, KSh 18,900 zilitoka, salio KSh 18,835." style="display:block;width:100%;max-width:552px;height:auto;margin-top:12px;border:0"/></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:32px"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:500;color:#141E2E;margin:0">Mboga na chakula zilichukua 30% ya wiki</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">Familia na marafiki iliongezeka maradufu hadi KSh 4,000 baada ya kutuma pesa nyumbani Ijumaa.</p><img src="cid:categories" width="552" alt="Donati ya matumizi ya KSh 20,450 kwa kategoria. Mboga na chakula KSh 6,120 (30%), familia na marafiki KSh 4,000 (20%), usafiri KSh 3,480 (17%), umeme na maji KSh 3,200 (16%), kula nje KSh 1,450, airtime na data KSh 1,150, mengineyo KSh 1,050." style="display:block;width:100%;max-width:552px;height:auto;margin-top:12px;border:0"/></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:32px"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:500;color:#141E2E;margin:0">Ijumaa ndiyo siku uliyotumia zaidi, KSh 6,350</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">Wastani wa siku ulikuwa KSh 2,921. Alhamisi ilikuwa tulivu zaidi, KSh 980.</p><img src="cid:daily" width="552" alt="Miraba saba, mmoja kwa kila siku, na mstari wa wastani wa KSh 2,921. Jumatatu KSh 2,840, Jumanne KSh 1,560, Jumatano KSh 4,210, Alhamisi KSh 980, Ijumaa KSh 6,350, Jumamosi KSh 3,120, Jumapili KSh 1,390." style="display:block;width:100%;max-width:552px;height:auto;margin-top:12px;border:0"/></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:32px"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.45;font-weight:500;colo