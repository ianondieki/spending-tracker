}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
  --h-paper: #101722;
  --h-sheet: #17202D;
  --h-rule: #2A3443;
  --h-ink: #E8ECF1;
  --h-ink-soft: #9AA6B5;
  --h-biro: #6D8DFF;
  --h-on-biro: #0B1220;
  --h-in: #4FC08D;
  --h-out: #E8ECF1;
  --h-fee: #E0A43C;
