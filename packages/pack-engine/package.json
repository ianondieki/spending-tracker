{
  "name": "@hesabu/pack-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-pack driven SMS parser engine (anchors, fields, transfer matching, dedupe).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "cli": "node dist/cli.js",
    "corpus": "node dist/cli.js run --corpus ../../corpus/mpesa/unverified-public-samples.jsonl"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "bin": {
    "pack-engine": "./dist/cli.js"
  }
}
