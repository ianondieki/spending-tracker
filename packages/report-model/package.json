{
  "name": "@hesabu/report-model",
  "version": "0.0.0",
  "private": true,
  "description": "Report document and facts-sheet types shared by analytics, charts, renderer and web.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "gen": "node --experimental-strip-types scripts/generate-types.ts",
    "fixtures": "vitest run --config vitest.fixtures.config.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4"
  }
}
