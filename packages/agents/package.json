{
  "name": "@hesabu/agents",
  "version": "0.0.0",
  "private": true,
  "description": "Report workflow agents: insight-select, write, deterministic check, numbers-only fallback, cost caps.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "try:model": "node --experimental-strip-types scripts/try-real-model.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hesabu/analytics": "workspace:*",
    "@hesabu/i18n": "workspace:*",
    "zod": "^4.6.6"
  }
}
