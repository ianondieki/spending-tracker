// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`HTML outputs for monthly-en > email HTML is table-based with cid images and a text twin 1`] = `
"<!doctype html>
<html lang="en"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light"/><meta name="supported-color-schemes" content="light"/><title>Your September in money: KSh 95,190 spent, KSh 20,000 saved</title></head><body style="margin:0;padding:0;background-color:#F3F5F7;color-scheme:light"><div style="display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1;color:#F3F5F7">Rent 23%, health up 133%, fees KSh 1,486. Bills expected in October.</div><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" style="background-color:#F3F5F7"><tbody><tr><td align="center" style="padding:24px 8px"><table role="presentation" width="600" cellPadding="0" cellSpacing="0" border="0" style="width:100%;max-width:600px;background-color:#FFFFFF;border-radius:8px"><tbody><tr><td style="padding:24px"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0"><tbody><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-bottom:12px;border-bottom:1px solid #C9D2DC"><span style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:700;color:#141E2E;margin:0;display:inline">Hesabu</span><span style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;display:inline;margin-left:12px">Monthly report</span><span style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;display:inline;float:right">September 2026</span></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:24px"><h1 style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:28px;line-height:1.1;font-weight:700;color:#141E2E;margin:0">Your September in money</h1></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:16px"><img src="cid:hero" width="552" alt="Total spent KSh 95,190, KSh +6,250 vs last month. You spent 7% more than in August and still put KSh 20,000 into M-Shwari." style="display:block;width:100%;max-width:552px;height:auto;border:0;border-radius:8px"/></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:8px"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" style="border-collapse:collapse"><tbody><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Rent and housing</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 22,000</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Groceries</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 18,240</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Family and friends</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 12,000</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Transport</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 11,460</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Utilities</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 8,199</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Eating out</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 7,310</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Everything else</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 15,981</td></tr><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:3px double #141E2E;font-size:14px;text-align:left;font-weight:700;padding-left:0;border-top:1px solid #141E2E">Total spent</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:3px double #141E2E;font-size:14px;text-align:right;font-weight:700;padding-left:12px;border-top:1px solid #141E2E">KSh 95,190</td></tr></tbody></table><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:400;color:#141E2E;margin:0;margin-top:12px"><b style="font-weight:500">KSh 6,250 more than last month</b></p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.45;font-weight:400;color:#141E2E;margin:0;margin-top:12px">You spent 7% more than in August and still put KSh 20,000 into M-Shwari.</p></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:24px"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" style="border-collapse:collapse"><tbody><tr><td valign="top" style="padding:12px 8px 12px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;width:25%;border-top:1px solid #C9D2DC;border-bottom:1px solid #C9D2DC"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0">Money in</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.1;font-weight:700;color:#1E7F5C;margin:0;margin-top:4px">KSh 104,350</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">KSh +3,150</p></td><td valign="top" style="padding:12px 8px 12px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;width:25%;border-top:1px solid #C9D2DC;border-bottom:1px solid #C9D2DC"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0">Money out</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.1;font-weight:700;color:#141E2E;margin:0;margin-top:4px">KSh 95,190</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">KSh +6,250</p></td><td valign="top" style="padding:12px 8px 12px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;width:25%;border-top:1px solid #C9D2DC;border-bottom:1px solid #C9D2DC"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0">Fees</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.1;font-weight:700;color:#B7791F;margin:0;margin-top:4px">KSh 1,486</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">KSh +366</p></td><td valign="top" style="padding:12px 8px 12px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;width:25%;border-top:1px solid #C9D2DC;border-bottom:1px solid #C9D2DC"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0">Saved</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.1;font-weight:700;color:#6B7A8F;margin:0;margin-top:4px">KSh 20,000</p></td></tr></tbody></table></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:32px"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:500;color:#141E2E;margin:0">Spending has climbed for two months while income edged up</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">September closed at KSh 7,674 net, down from KSh 11,140 in August.</p><img src="cid:trend" width="552" alt="Three lines over six months, April to September, for money in, money out and net. Income rose from KSh 92,400 to KSh 104,350. Spending rose from KSh 84,210 to KSh 95,190. Net was highest in August at KSh 11,140 and KSh 7,674 in September, which is highlighted." style="display:block;width:100%;max-width:552px;height:auto;margin-top:12px;border:0"/></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:32px"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:500;color:#141E2E;margin:0">Income beat spending by KSh 7,674 after fees</p><img src="cid:in_out" width="552" alt="Two bars compare September and August. September: KSh 104,350 in, KSh 95,190 out, net KSh 7,674. August: KSh 101,200 in, KSh 88,940 out, net KSh 11,140." style="display:block;width:100%;max-width:552px;height:auto;margin-top:12px;border:0"/></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:32px"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:500;color:#141E2E;margin:0">Rent and groceries took 23% and 19% of the month</p><img src="cid:waterfall" width="552" alt="A waterfall from KSh 104,350 income down through rent KSh 22,000, groceries KSh 18,240, family and friends KSh 12,000, transport KSh 11,460, utilities KSh 8,199, other categories and fees KSh 1,486, ending at KSh 7,674 net." style="display:block;width:100%;max-width:552px;height:auto;margin-top:12px;border:0"/></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:32px"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:16px;line-height:1.45;font-weight:500;color:#141E2E;margin:0">Rent is 23% of spending; health more than doubled</p><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:14px;line-height:1.45;font-weight:400;color:#5B6878;margin:0;margin-top:4px">Health rose 133% to KSh 4,200 after a hospital visit. Other fell KSh -2,709.</p><img src="cid:categories" width="552" alt="Donut of KSh 95,190 spending by category. Rent and housing KSh 22,000 (23%), groceries KSh 18,240 (19%), family and friends KSh 12,000 (13%), transport KSh 11,460 (12%), utilities KSh 8,199 (9%), eating out KSh 7,310 (8%), the remaining four categories make up the rest." style="display:block;width:100%;max-width:552px;height:auto;margin-top:12px;border:0"/></td></tr><tr><td style="padding:0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;padding-top:32px"><p style="font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;font-size:20px;line-height:1.45;font-weight:500;color:#141E2E;margin:0;margin-bottom:12px">Where it went</p><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" style="border-collapse:collapse"><thead><tr><th style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#5B6878;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left">Category</th><th style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#5B6878;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right">Spent</th><th style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#5B6878;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right">Share</th><th style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#5B6878;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right">vs August</th></tr></thead><tbody><tr><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:left;font-weight:400;padding-left:0">Rent and housing</td><td style="padding:8px 0;font-family:&#x27;Schibsted Grotesk&#x27;, system-ui, -apple-system, Roboto, sans-serif;color:#141E2E;border-bottom:1px solid #C9D2DC;font-size:14px;text-align:right;font-weight:400;padding-left:12px">KSh 22,000</td><td style="padding:8px 0;font-family:&#x27;Schibsted 