{
  "name": "@hesabu/renderer",
  "version": "0.0.0",
  "private": true,
  "description": "Renders a ReportDocument to standalone HTML, hero PNG, chart PNGs, A4 PDF and email (HTML and text).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "golden": "HESABU_RENDERER_GOLDEN=write vitest run src/golden.test.ts"
  },
  "dependencies": {
    "@hesabu/charts": "workspace:*",
    "@hesabu/report-model": "workspace:*",
    "playwright": "1.56.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdfjs-dist": "^5.7.284",
    "pngjs": "^7.0.0"
  }
}
