# Hesabu environment. Copy to `.env` (untracked) and fill in sandbox/test values only.
# Every service fails closed when a variable it needs is missing or empty. Never commit real secrets.

# ----- AI (packages/agents, apps/worker) -----
# Anthropic API key for the report workflow. Set a spend cap in the Anthropic console first.
# Empty, or AI_ENABLED != "true", forces the numbers-only fallback report (numbers are computed, never generated).
ANTHROPIC_API_KEY=
# Master switch for model calls. Only the exact string "true" enables them.
AI_ENABLED=true
# Hard daily spend cap in USD across all model calls; the worker stops calling the model once it is reached.
AI_DAILY_BUDGET_USD=2

# ----- Database (packages/db, apps/api, apps/worker) -----
# Postgres connection string. The default matches infra/docker-compose.yml.
DATABASE_URL=postgres://hesabu:hesabu@localhost:5432/hesabu

# ----- Email via Resend (apps/worker) -----
# Resend API key (the free tier with the default test sender is enough to email yourself).
RESEND_API_KEY=
# Sender shown on report emails, "Name <address>". onboarding@resend.dev works without domain verification.
RESEND_FROM="Hesabu <onboarding@resend.dev>"

# ----- WhatsApp Cloud API, Meta test number (apps/worker, apps/api webhook) -----
# Temporary access token from the Meta developer app (WhatsApp product).
WHATSAPP_TOKEN=
# Phone number ID of the Meta test number (not the number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; Meta sends it back when verifying the webhook URL. The API rejects mismatches.
WHATSAPP_VERIFY_TOKEN=

# ----- Report recipients (single user for Day One) -----
# Where weekly and monthly report emails go.
REPORT_TO_EMAIL=
# WhatsApp recipient in E.164 format (e.g. +2547XXXXXXXX). Must be a verified recipient of the Meta test number.
REPORT_TO_WHATSAPP=

# ----- Secrets (generate each with: openssl rand -hex 32) -----
# HMAC secret that signs /r/<token> report links; rotating it invalidates every link.
REPORT_LINK_SECRET=
# HMAC secret that signs device tokens issued to the Android app.
DEVICE_TOKEN_SECRET=

# ----- Object storage for report assets: hero PNG, chart PNGs, PDFs (S3-compatible; MinIO locally) -----
# S3 endpoint URL. The defaults match the minio service in infra/docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
# Bucket name; infra/docker-compose.yml creates it on `make dev`.
S3_BUCKET=hesabu
# Access key (MinIO root user locally).
S3_ACCESS_KEY=hesabu
# Secret key (MinIO root password locally; at least 8 characters).
S3_SECRET_KEY=hesabu-dev-secret

# ----- App -----
# Public base URL used in report links and webhooks (the tunnel URL when Meta/Resend must reach your laptop).
APP_BASE_URL=http://localhost:3000
# Process time zone. Reports, schedules and Monday weeks are computed in Africa/Nairobi.
TZ=Africa/Nairobi

# ----- Added by Lane B (api and worker) -----
# Meta app secret; when set the API verifies X-Hub-Signature-256 on /webhooks/whatsapp (leave empty in local dev).
WHATSAPP_APP_SECRET=
# Graph API version used by the WhatsApp Cloud API adapter.
WHATSAPP_API_VERSION=v21.0
# Resend webhook signing secret (whsec_...); when set the API verifies the Svix headers on /webhooks/email.
RESEND_WEBHOOK_SECRET=
# How long a signed /r/<token> web report link stays valid.
REPORT_LINK_TTL_DAYS=30
# Where artefacts go when S3 is not configured (local development only; production refuses to run without S3).
STORAGE_DIR=.hesabu-storage
# S3 region. The bucket stays private: readers get 15-minute presigned URLs, never a public base URL.
S3_REGION=us-east-1
# API listen port, the API's own public URL (signed artefact route; apps/web also reads API_BASE_URL) and the URL the seed posts to.
PORT=8787
API_BASE_URL=http://localhost:8787
API_URL=http://localhost:8787
# apps/web: serve the fixture routes (/dev/report) outside development. Leave empty in production.
HESABU_DEV_ROUTES=
# packages/renderer: let a browser-less environment produce placeholder PNG/PDF instead of failing. Tests only; a
# report rendered this way is flagged `stubbed` and is never delivered. Leave empty everywhere else.
HESABU_RENDERER_ALLOW_STUB=
